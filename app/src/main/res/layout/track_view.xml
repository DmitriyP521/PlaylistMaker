<?xml version="1.0" encoding="utf-8" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp61">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="@dimen/dp0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/artworkUrl100"
                android:layout_width="@dimen/dp45"
                android:layout_height="@dimen/dp45" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp8"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/trackName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ys_text_regular"
                    android:textSize="@dimen/sp16"
                    style="@style/TextViewTrackNameStyle"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/artistName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp1"
                        android:fontFamily="@font/ys_text_regular"
                        android:textSize="@dimen/sp11"
                        style="@style/TextViewArtistStyle"/>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp5"
                        android:paddingTop="@dimen/dp2"
                        android:src="@drawable/baseline_circle_3"
                        android:gravity="center"
                        style="@style/ImageViewTrackStyle" />

                    <TextView
                        android:id="@+id/trackTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp1"
                        android:fontFamily="@font/ys_text_regular"
                        android:textSize="@dimen/sp11"
                        style="@style/TextViewArtistStyle"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:src="@drawable/baseline_keyboard_arrow_right_24"
            style="@style/ImageViewTrackStyle" />

    </LinearLayout>

</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/pm_black</item>
        <item name="android:textSize">@dimen/sp22</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="iconTint">@color/pm_black</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/dp8</item>
        <item name="cornerRadius">@dimen/dp16</item>
    </style>
    <style name="SettingsLinearLayoutStyle">
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="SettingsTextViewStyle">
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:textSize">@dimen/sp16</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>
    <style name="SettingsImageViewStyle">
        <item name="android:layout_width">@dimen/dp24</item>
        <item name="android:layout_height">@dimen/dp24</item>
        <item name="android:tint">@color/gray</item>
    </style>
    <style name="BackArrowButtonStyle">
        <item name="android:backgroundTint">?attr/colorSecondary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="icon">@drawable/baseline_arrow_back_24</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">?attr/colorOnSecondary</item>
    </style>
    <style name="HeaderTextViewStyle">
        <item name="android:paddingLeft">@dimen/dp12</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:textSize">@dimen/sp22</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>
    <style name="SwitchMaterialStyle">
        <item name="thumbTint">@color/teal</item>
        <item name="trackTint">@color/light_teal</item>
    </style>
    <style name="EditTextViewStyle">
        <item name="android:textColorHint">@color/gray</item>
        <item name="android:drawableTint">@color/gray</item>
    </style>
    <style name="EditTextIconStyle">
        <item name="tint">@color/gray</item>
    </style>
</resources>